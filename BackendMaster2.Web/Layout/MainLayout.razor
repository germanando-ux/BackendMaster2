@using BackendMaster2.Web.Interfaces
@inherits LayoutComponentBase
@inject ISessionService SessionService
@inject NavigationManager NavigationManager

<div class="app-layout">
    <nav class="app-navvar">
        <div class="navbar-brand">BackendMaster2</div>
        <button class="nabbar-logout" title="Cerrar sesión" @onclick="CerrarSesionAsync">
            Salir
        </button>
    </nav>

    <div class="app-body"> 
        <aside class="app-sidebar">
            <nav class="sidebar-menu">
                <a href="/" class="sidebar-link">Inicio</a>
                <a href="/productos" class="sidebar-link">Productos</a>
                <a href="/usuarios" class="sidebar-link">Usuarios</a>
            </nav>
        </aside>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
     /// <summary>
    /// Cada vez que termina de cargar la página en el layout, se comprueba si la sesión sigue activa. Si no los hay, se redirige a la página de login.
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tokens = await SessionService.GetAsync();
            if (tokens == null)
            {
                NavigationManager.NavigateTo("/login");
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }


    /// <summary>
    /// Cierra la sesión del usuario.
    /// </summary>
    /// <returns></returns>
    private async Task CerrarSesionAsync()
    {
        await SessionService.DeleteAsync();
        NavigationManager.NavigateTo("/login");
    }
}