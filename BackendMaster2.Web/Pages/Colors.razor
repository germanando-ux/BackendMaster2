@page "/colors"
@using System.Net
@using BackendMaster2.Web.Components
@using BackendMaster2.Web.Interfaces
@using BackendMaster2.Web.Services
@inject IColorClient ColorClient
@inject ISessionService SessionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS;
@inherits FormBaseComponent //hereda de FormBaseComponent para manejar errores y variables de estado


<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="mb-1">Colores</h1>
        <p class="text-muted mb-0">Gestión de colores</p>
    </div>
    <div>  </div>
    <a href="/colors/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Color
    </a>
</div>

@if (IsLoading)
{
    <p class="text-muted">Cargando colores…</p>
}
else if (ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}
else
{
    <div class="card shadow mb-4">


        <table class="table table-bordered table-striped table-hover">
            <thead class="table-encabezado-marca">
                <tr>
                    <th>Nombre</th>
                    <th>Hexadecimal/color</th>
                    <th>Estado</th>
                    <th class="text-center" style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var color in _colores)
                {
                <tr>
                        <td class ="align-middle">@color.Name</td>
                        <td >
                            <div class="d-inline-flex align-items-center gap-2">
                               <span> @color.HexCode </span> <div style="width: 20px; height: 20px; background-color: @color.HexCode; border: 1px solid #ccc; margin-left: 10px;"></div>
                            </div>
                        </td>
                        <td>
                            @if (color.IsActive)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-center align-middle">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/colors/edit/@color.Id" class="btn btn-sm btn-outline-primary" title="Editar color">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar color" @onclick="() => PrepararBorradoColor(color.Id, color.Name)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                </tr>
                }
            </tbody>
        </table>

    </div>
}

<ConfirmModal Show="@(_colorIdPendiente.HasValue)"
              IsError="@_modalEsError"
              Title="@(_modalEsError ? "No se puede eliminar" : "Eliminar color")"
              Message="@_colorNombrePendiente"
              ConfirmText="Eliminar"
              CancelText="Cancelar"
              OnConfirm="ConfirmarBorradoColor"
              OnCancel="CancelarBorradoColor" />

@code {

    // Guardan el Id y el nombre del color que el usuario quiere borrar.
    // Si _colorIdPendiente es null, no hay ningún borrado en curso.
    private Guid? _colorIdPendiente;
    private string? _colorNombrePendiente;
    private bool _modalEsError;

    private List<ColorDto> _colores = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadColorsAsync();
    }

    private async Task LoadColorsAsync()
    {
        var result = await ColorClient.GetAllColorsAsync();
        if (!result.IsSuccess)
        {
            ErrorMessage = ErrorHandler.HandleError(result);
            return;
        }

        _colores = result.Data ?? new List<ColorDto>();
        IsLoading = false;
    }

    /// <summary>
    /// Se ejecuta si el usuario pulsa "Cancelar" o cierra el modal.
    /// Simplemente limpia el estado para que el modal desaparezca.
    /// </summary>
    private void CancelarBorradoColor()
    {
        _colorIdPendiente = null;
        _colorNombrePendiente = null;
    }

    /// <summary>
    /// Se ejecuta si el usuario pulsa "Eliminar". Realiza el borrado real.
    /// </summary>
    private async Task ConfirmarBorradoColor()
    {
        if (!_colorIdPendiente.HasValue) return;

        var result = await ColorClient.DeleteColorAsync(_colorIdPendiente.Value);

        if (result.IsSuccess)
        {
            await LoadColorsAsync(); // Refresca la tabla
            CancelarBorradoColor();  // Cierra el modal solo si todo fue bien
        }
        else
        {
            // Transformamos el modal en modo error sin cerrarlo
            _modalEsError = true;
            _colorNombrePendiente = ErrorHandler.HandleError(result); // Reutilizamos el mensaje del backend
        }
    }

    /// <summary>
    /// Prepara los datos para mostrar el modal de confirmación.
    /// </summary>
    private void PrepararBorradoColor(Guid id, string nombre)
    {
        _colorIdPendiente = id;
        _colorNombrePendiente = nombre;
        _modalEsError = false; // Resetear el modo error

    }
}


