@page "/productos"
@using System.Net
@using BackendMaster2.Web.Interfaces
@using BackendMaster2.Web.Models.Dtos
@using BackendMaster2.Web.Services
@inject ISessionService SessionService
@inject NavigationManager NavigationManager
@inject IProductsClient ProductsClient
@inject ErrorHandler ErrorHandler

<h1 class="mb-1">Productos</h1>
<p class="text-muted mb-4">Gestión de productos</p>

@if (_cargando)
{
    <p class="text-muted">Cargando productos…</p>
}
else if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else
{
    <div class="card shadow mb-4">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-encabezado-marca">
                <tr>
                    <th>SKU</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in _productos)
                {
                    <tr>
                        <td>@producto.Sku</td>
                        <td>@producto.Name</td>
                        <td>@producto.Price.ToString("N2")</td>
                        <td>@producto.Stock</td>
                        <td>
                            @if (producto.IsActive)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProductDto> _productos = new();
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await ProductsClient.GetAllProductsAsync();

        if (!result.IsSuccess)
        {
            _error = ErrorHandler.HandleError(result);
            return;
        }

        _productos = result.Data ?? new List<ProductDto>();
        _cargando = false;
    }

 
}