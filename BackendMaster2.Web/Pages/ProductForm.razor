@page "/productos/crear"
@page "/productos/editar/{Id:guid}"

@using BackendMaster2.Web.Components
@using BackendMaster2.Web.Interfaces
@using BackendMaster2.Web.Models.Dtos

@inject IProductsClient ProductsClient
@inject NavigationManager Navigation
@inject IColorClient ColorClient

@inherits FormBaseComponent //hereda de FormBaseComponent para manejar errores y variables de estado

@if (IsLoading)
{
    <div class="alert alert-info"> Cargando datos...</div>
}
else
{
    <form @onsubmit="HandleSubmit">
        <div class="col-md-8 mb-3">
            <label class="form-label">SKU</label>
            <input type="text" class="form-control border-primary" @bind="dto.Sku" />
        </div>

        <div class="col-md-8 mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control border-primary" @bind="dto.Name" />
        </div>

        <div class="col-md-8 mb-3">
            <label class="form-label">Descripción</label>
            <textarea class="form-control border-primary" rows="3" @bind="dto.Description"></textarea>
        </div>

        <div class="col-6 mb-3">
            <label class="form-label ">Precio</label>
            <input type="number" step="0.01" class="form-control border-primary" @bind="dto.Price"
                   onkeydown="if(event.key === '.') { event.preventDefault(); this.value = this.value + ','; }"
                   required />
        </div>

        <div class="col-6 mb-3">
            <label class="form-label">Stock</label>
            <input type="number" class="form-control border-primary" @bind="dto.Stock"
                   onkeydown="if(event.key === '.') { event.preventDefault(); this.value = this.value + ','; }"
                   required />
        </div>

        <div class="mb-4 form-check">
            <input type="checkbox" class="form-check-input" @bind="dto.IsActive" />
            <label class="form-check-label">Producto Activo</label>
        </div>

        <hr class="my-4" />

        <div class="mb-4">
            <label class="form-label fw-semibold fs-5">Colores</label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var color in availableColors)
                {
                    var seleccionado = dto.ColorIds.Contains(color.Id);

                    <div class="d-flex align-items-center gap-2 border rounded p-2" @onclick="() => ToggleColor(color.Id)"
                        style="cursor:pointer; border-color:@(seleccionado ? "#0d6efd" : "#dee2e6") !important;background:@(seleccionado ? "#e7f1ff" : "white");">
                        <div style="width:28px; height:28px; background-color:@color.HexCode; border:1px solid #ccc; border-radius:4px;"></div>
                        <div>
                            <div class="small fw-semibold">@color.Name</div>
                            <div class="small text-muted font-monospace">@color.HexCode</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
        </div>

    </form>
}

@code {

    // 2. El objeto que va a "viajar" al backend.
    private ProductDto dto = new();

    private List<ColorDto> availableColors = new();


    // 1. Se ejecuta al entrar en la página. Si es edición, carga los datos.
    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            IsLoading = true;
            var result = await ProductsClient.GetProductDetailByIdAsync(Id.Value);

            if (result.IsSuccess && result.Data != null)
            {
                dto = result.Data.Product; // Rellenamos el formulario con los datos
            }
            else
            {
                ErrorMessage = "No se pudo cargar el producto.";
            }

            //cargamos todos los colores disponibles 
            var colorsResult = await ColorClient.GetAllColorsAsync();
            if (colorsResult.IsSuccess)
            {
                availableColors = colorsResult.Data ?? new();
            }
            
        }
        IsLoading = false;
    }

    // 2. Se ejecuta al pulsar "Guardar"
    private async Task HandleSubmit()
    {
        IsSaving = true;
        ErrorMessage = null;

        ApiResult<ProductDto> result;

        // Decidimos si crear o actualizar según si tenemos un Id
        if (IsEdit)
        {
            result = await ProductsClient.UpdateProductAsync(Id.Value, dto);
        }
        else
        {
            result = await ProductsClient.CreateProductAsync(dto);
        }

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/productos"); // Vuelve al grid (ajusta la ruta si es distinta)
        }
        else
        {
            ErrorMessage = "Error al guardar. Revisa los datos.";
        }

        IsSaving = false;
    }

    // 3. Acción para el botón Cancelar
    private void Cancel()
    {
        Navigation.NavigateTo("/productos");
    }

    /// <summary>
    /// Añade o quita un color de la selección del producto (toggle).
    /// </summary>
    private void ToggleColor(Guid colorId)
    {
        if (dto.ColorIds.Contains(colorId))
        {
            dto.ColorIds.Remove(colorId);   // Ya estaba elegido → lo quitamos
        }
        else
        {
            dto.ColorIds.Add(colorId);      // No estaba → lo añadimos
        }
    }
}
