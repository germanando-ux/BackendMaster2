@using BackendMaster2.Web.Interfaces
@inherits LayoutComponentBase
@inject ISessionService SessionService
@inject NavigationManager NavigationManager

<div class="app-layout">
    <nav class="app-navbar">
        <button class="navbar-toggle" @onclick="AlternarSidebar" title="Menú"><i class="bi bi-list"></i></button>
        <div class="navbar-brand">BackendMaster2</div>
        <button class="navbar-logout" title="Cerrar sesión" @onclick="CerrarSesionAsync">
            Salir
        </button>
    </nav>

    <div class="app-body">         
        <aside class="app-sidebar @(_sidebarAlternado ? "alternado" : "")">
            <nav class="sidebar-menu">
         
                <NavLink href="/" class="sidebar-link" Match="NavLinkMatch.All"><i class="bi bi-house-door"></i><span class="link-texto">Inicio</span></NavLink>
                <NavLink href="/productos" class="sidebar-link"><i class="bi bi-box-seam"></i><span class="link-texto">Productos</span></NavLink>
                <NavLink href="/usuarios" class="sidebar-link"><i class="bi bi-people"></i><span class="link-texto">Usuarios</span></NavLink>
            </nav>
        </aside>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    /// <summary>
    /// Cada vez que termina de cargar la página en el layout, se comprueba si la sesión sigue activa. Si no los hay, se redirige a la página de login.
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tokens = await SessionService.GetAsync();
            if (tokens == null)
            {
                NavigationManager.NavigateTo("/login");
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }


    /// <summary>
    /// Cierra la sesión del usuario.
    /// </summary>
    /// <returns></returns>
    private async Task CerrarSesionAsync()
    {
        await SessionService.DeleteAsync();
        NavigationManager.NavigateTo("/login");
    }
    /// <summary>
    /// Alterna la visibilidad de la barra lateral.
    /// </summary>
    private bool _sidebarAlternado;

    private void AlternarSidebar()
    {
        _sidebarAlternado = !_sidebarAlternado;
    }
}