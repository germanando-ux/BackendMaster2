@page "/products/create"
@page "/products/{Mode}/{Id:guid}"

@using BackendMaster2.Web.Components
@using BackendMaster2.Web.Extensions
@using BackendMaster2.Web.Interfaces
@using BackendMaster2.Web.Models.Dtos
@using BackendMaster2.Web.Services

@inject IProductsClient ProductsClient
@inject NavigationManager Navigation
@inject IColorClient ColorClient
@inject ToastService ToastService
@inject INotificationClientService NotificationService
@inject ICategoryClient CategoryClient
@inject ISizeClient SizeClient
@inject ISizeGroupClient SizeGroupClient
@inject IDataSourceClient DataSourceClient
@inject IMarketplaceClient MarketplaceClient
@inject IFeatureClient FeatureClient

@inherits FormBaseComponent //hereda de FormBaseComponent para manejar errores y variables de estado


@if (IsLoading)
{
    <div class="alert alert-info"> Cargando datos...</div>
}
else
{
    <EditForm Model="productDto" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        @if (IsReadOnly)
        {
            <div class="alert alert-info py-2 mb-3 small">
                <i class="bi bi-eye me-2"></i>Modo consulta: campos de solo lectura.
            </div>
        }

        <!-- PESTAÑAS (TABS) -->
        <ul class="nav nav-tabs mb-4" id="productTabs" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "general" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("general"))">
                    <i class="bi bi-info-circle me-1"></i> Datos Generales
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(activeTab == "clasificacion" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("clasificacion"))">
                    <i class="bi bi-tags me-1"></i> Clasificación
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(activeTab == "variantes" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("variantes"))">
                    <i class="bi bi-rulers me-1"></i> Variantes (Tallas)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(activeTab == "canales" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("canales"))">
                    <i class="bi bi-shop me-1"></i> Canales
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(activeTab == "caracteristicas" ? "active" : "")"
                        @onclick="@(() => SetActiveTab("caracteristicas"))">
                    <i class="bi bi-card-checklist me-1"></i> Características
                </button>
            </li>
        </ul>

        <!-- CONTENIDO DE LAS PESTAÑAS -->
        <div class="tab-content" id="productTabsContent">

            <!-- PESTAÑA 1: DATOS GENERALES (Activa por defecto) -->
            <div class="tab-pane fade @(activeTab == "general" ? "show active" : "")">
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="form-label">SKU</label>
                        <input type="text" class="form-control border-primary " @bind="productDto.Sku" disabled="@IsReadOnly" />
                        <ValidationMessage For="@(() => productDto.Sku)" class="text-danger small" />
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control border-primary" @bind="productDto.Name" disabled="@IsReadOnly" />
                        <ValidationMessage For="@(() => productDto.Name)" class="text-danger small" />
                    </div>

                    <div class=" col-md-8 mb-3 gap-3">
                        <label class="form-label">Descripción</label>
                        <div class="d-flex gap-3 align-items-center">
                            <textarea class="form-control border-primary" rows="3" @bind="productDto.Description" disabled="@IsReadOnly"></textarea>
                            <ValidationMessage For="@(() => productDto.Description)" class="text-danger small" />
                            <button type="button" class="btn btn-primary" @onclick="RequestAiEnhancementAsync">Mejorar descripción (IA)</button>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Precio</label>
                            <div class="gap-3">
                                <NumberInput @bind-Value="productDto.Price" CssClass="form-control" class="border-primary" required />
                                <ValidationMessage For="@(() => productDto.Price)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Stock</label>
                            <input type="number" class="form-control border-primary" @bind="productDto.Stock" required />
                            <ValidationMessage For="@(() => productDto.Stock)" class="text-danger small" />
                        </div>
                    </div>
                    <div class="mb-4 form-check">
                        <input type="checkbox" class="form-check-input" @bind="productDto.IsActive" disabled="@IsReadOnly" />
                        <label class="form-check-label">Producto Activo</label>
                    </div>
                </div>




            </div>
            <!-- PESTAÑA 2: CLASIFICACIÓN  -->
            <div class="tab-pane fade @(activeTab == "clasificacion" ? "show active" : "")">
                <div class="row">
                    @* COLORES *@
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-semibold fs-5"><i class="bi bi-palette me-2"></i>Colores</label>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var color in availableColors)
                            {
                                var seleccionado = productDto.ColorIds.Contains(color.Id);

                                <div class="d-flex align-items-center gap-2 border rounded p-2" @onclick="() => ToggleColor(color.Id)"
                                     style="cursor::@(IsReadOnly ? "default" : "pointer"); border-color:@(seleccionado ? "#0d6efd" : "#dee2e6") !important;background:@(seleccionado ? "#e7f1ff" : "white");">
                                    <div style="width:28px; height:28px; background-color:@color.HexCode; border:1px solid #ccc; border-radius:4px;"></div>
                                    <div>
                                        <div class="small fw-semibold">@color.Name</div>
                                        <div class="small text-muted font-monospace">@color.HexCode</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @* CATEGORÍAS *@
                    <!-- Columna 2: Categorías -->
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-semibold fs-5"><i class="bi bi-folder me-2"></i>Categorías</label>
                        <select class="form-select" @bind="SelectedCategoryId">
                                <option value="">Seleccione categoría</option>
                                 @foreach (var category in availableCategories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        @* <div class="list-group">
                            @foreach (var category in availableCategories)
                            {
                                var seleccionado = productDto.CategoryIds.Contains(category.Id);
                                <label class="list-group-item d-flex gap-2 align-items-center" style="cursor: @(IsReadOnly ? "default" : "pointer");">
                                    <input class="form-check-input flex-shrink-0" type="checkbox"
                                           checked="@seleccionado"
                                           disabled="@IsReadOnly"
                                           @onchange="() => ToggleCategory(category.Id)" />
                                    <span>@category.Name</span>
                                </label>
                            }
                        </div> *@
                    </div>
                </div>
            </div>

            <!-- PESTAÑA 3: VARIANTES  -->
            <div class="tab-pane fade @(activeTab == "variantes" ? "show active" : "")">
                <label class="form-label fw-semibold fs-5"><i class="bi bi-rulers me-2"></i>Variantes de talla</label>
                <div class="card mb-3 p-3 bg-info">
                    <label class="form-label">
                        <i class="bi bi-info-circle-fill"></i> <strong>¿Cómo añadir tallas?</strong> Usa "Añadir Grupo" para cargar todas las tallas de una categoría de golpe, o "Añadir Talla" para incorporar variantes sueltas.
                    </label>
                </div>
                @* grupo de combos de grupos de tallas y combos de tallas sueltas *@
                <div class="card  shadow-sm mb-4">
                    <div class="card mb-3 p-3 bg-light">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold fs-5">Añadir Talla Suelta</label>
                                <div class="input-group">
                                    <select class="form-select" @bind="selectedSize">
                                        @foreach (var size in availableSizes)
                                        {
                                            <option value="@size.Id">@size.Name</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-primary" @onclick="addSelectedSize">
                                        <i class="bi bi-plus-lg"></i>Añadir talla
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold fs-5">Añadir Grupo Completo</label>
                                <div class="input-group">
                                    <select class="form-select" @bind="selectedSizeGroups">
                                        @foreach (var sizeGroup in availableSizeGroups)
                                        {
                                            <option value="@sizeGroup.Id">@sizeGroup.Name</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-primary" @onclick="addSelectedGroupSize">
                                        <i class="bi bi-plus-lg"></i>Añadir grupo
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* tabla de tallas *@
                <div class="card shadow mb-4">
                    <table class="table table-bordered table-striped table-hover">
                        <thead class="table-encabezado-marca">
                            <tr>
                                <th>
                                    Talla
                                </th>
                                <th>
                                    Grupo
                                </th>
                                <th>Stock variante</th>
                                <th>Sku variante</th>
                                <th>Precio (€)</th>
                                <th class="text-center" style="width: 120px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var productSize in productDto.ProductSizes)
                            {
                                <tr>
                                    <td class="align-middle">@productSize.SizeName</td>
                                    <td> <span class="badge text-bg-success">@productSize.SizeGroupName</span></td>
                                    <td class="align-middle">
                                        <input type="number"
                                               class="form-control form-control-sm border-primary  text-end"
                                               @bind="productSize.Stock" />
                                    </td>
                                    <td class="align-middle">
                                        <input type="text"
                                               class="form-control form-control-sm border-primary"
                                               @bind="productSize.Sku" />
                                        <ValidationMessage For="@(() => productSize.Sku)" class="text-danger small d-block" />
                                    </td>
                                    <td class="align-middle">
                                        <input type="number"
                                               class="form-control form-control-sm border-primary text-end"
                                               @bind="productSize.Price"
                                               step="0.01" />
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => RemoveproductSize(productSize.SizeId)"
                                                    title="Quitar característica">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>


            <!-- PESTAÑA 4: CANALES  -->
            <div class="tab-pane fade @(activeTab == "canales" ? "show active" : "")">
                <div class="row">
                    @* ORIGENES *@
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-semibold fs-5"><i class="bi bi-database-down me-2"></i>Origen del producto</label>
                        <div class="card mb-3 p-3 bg-info">
                            <label class="form-label">
                                <i class="bi bi-info-circle-fill"></i> Un producto tiene un <strong> único origen </strong>.
                            </label>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label">Origen de datos</label>
                            <select class="form-select" @bind="SelectedDataSourceId" disabled="@IsReadOnly">
                                <option value="">Seleccione un origen de datos</option>
                                @foreach (var datasource in availableDataSources)
                                {
                                    <option value="@datasource.Id">@datasource.Name</option>
                                }
                            </select>
                        </div>

                        @if (CurrentProductDataSource is not null)
                        {
                            <div class="col-md-6 mb-4">
                                <label class="form-label">Código externo en el origen</label>
                                <input type="text" class="form-control border-primary"
                                       @bind="CurrentProductDataSource.ExternalCode"
                                       disabled="@IsReadOnly"
                                       placeholder="Ej.: PROV-A-998" />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label">Última sincronización</label>
                                <input type="text" class="form-control"
                                       value="@(CurrentProductDataSource.LastSyncedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")"
                                       readonly disabled />
                                <div class="form-text">Gestionado por el sistema en cada sync.</div>
                            </div>
                        }
                    </div>
                    @* MARKETPLACES *@

                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-semibold fs-5"><i class="bi bi-shop-window me-2"></i>Marketplaces</label>
                        @* Tabla de marketplaces *@
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0 fw-bold">
                                    <i class="bi bi-tags me-2"></i>Marketplaces
                                    <span class="badge bg-success text-white ms-2">@productDto.ProductMarketplaces.Count publicados</span>
                                </h6>
                            </div>
                            <div class="card-body">
                                @if (productDto.ProductMarketplaces != null && productDto.ProductMarketplaces.Any())
                                {
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Marketplace</th>
                                                <th>Código externo</th>
                                                <th>Última sinc.</th>
                                                <th class="text-center" style="width: 120px;">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var mp in productDto.ProductMarketplaces)
                                            {
                                                <tr>
                                                    <td class="align-middle">@mp.MarketplaceName</td>
                                                    <td class="align-middle">
                                                        <input type="text"
                                                               class="form-control form-control-sm border-primary"
                                                               @bind="mp.ExternalCode" />
                                                    </td>
                                                    <td class="align-middle">@mp.LastSyncedAt</td>
                                                    <td class="text-center align-middle">
                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => RemoveMarketplace(mp.MarketplaceId)"
                                                                title="Quitar marketplace">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                                        <span class="small">No hay características asignadas a esta categoría.</span>
                                    </div>
                                }
                            </div>
                        </div>

                        @* bloque búsqueda y añadir características *@
                        <div class="col-md-12 mb-3">
                            <div class="p-3 bg-light rounded border">
                                <label class="form-label fw-bold small text-uppercase text-muted mb-2">
                                    <i class="bi bi-search me-1"></i> Añadir marketplace
                                </label>
                                <input type="text" class="form-control form-control-sm mb-2" placeholder="Escribe para filtrar..." @bind="_filtroMarketplaces" @bind:event="oninput" />

                                <div class="d-flex gap-2">
                                    <select class="form-select form-select-sm shadow-sm" size="5" @bind="selectedMarketplaceId">
                                        @foreach (var mp in filteredMarketplaces)
                                        {
                                            <option value="@mp.Id">@mp.Name</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center" @onclick="AddSelectedFeature" title="Añadir a la lista">
                                        <i class="bi bi-plus-lg fs-5"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- PESTAÑA 5: CARACTERÍSTICAS  -->
            <div class="tab-pane fade @(activeTab == "caracteristicas" ? "show active" : "")">
                <label class="form-label fw-semibold fs-5"><i class="bi bi-list-stars me-2"></i>Características</label>
                <div class="card mb-3 p-3 bg-info">
                    <label class="form-label">
                        <i class="bi bi-info-circle-fill"></i>Selecciona una <strong>categoría</strong> en la pestaña Clasificación para cargar sus características obligatorias. También puedes añadir características libres desde el catálogo.
                    </label>
                </div>

                @* tabla de características *@
                <div class="card shadow mb-4">
                    <table class="table table-bordered table-striped table-hover">
                        <thead class="table-encabezado-marca">
                            <tr>
                                <th>Característica</th>
                                <th>Tipo</th>
                                <th>Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var productFeatures in productDto.ProductFeatures)
                            {
                                <tr>
                                    <td class="align-middle">@productFeatures.FeatureName</td>
                                    <td> <span class="badge text-bg-success">@productFeatures.DataType.GetDisplayName()</span></td>
                                
                                    <td class="align-middle">
                                        @if (productFeatures.DataType == FeatureDataType.Text)
                                        {
                                            <input type="text" class="form-control form-control-sm border-primary" @bind="productFeatures.Value" />
                                        }
                                        else if (productFeatures.DataType == FeatureDataType.Number)
                                        {
                                            <input type="number" class="form-control form-control-sm text-end" @bind="productFeatures.Value" />
                                        }
                                        else if (productFeatures.DataType == FeatureDataType.Boolean)
                                        {
                                            <div class="form-check form-switch">
                                                <input type="checkbox" class="form-check-input"
                                                       checked="@(productFeatures.Value == "true")"
                                                       @onchange="@(e => productFeatures.Value = (bool)e.Value ? "true" : "false")" />
                                            </div>
                                        }
                                        else if (productFeatures.DataType == FeatureDataType.List)
                                        {
                                            <select class="form-select form-select-sm" @bind="productFeatures.FeatureOptionId">
                                                    <option value="">Selecciona...</option>
                                                @foreach (var opt in GetFeatureOptions(productFeatures.FeatureId))
                                                    {
                                                        <option value="@opt.Id">@opt.Value</option>
                                                    }
                                            </select>
                                        }
                            
                                        @* <ValidationMessage For="@(() => productFeatures.Sku)" class="text-danger small d-block" /> *@
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => RemoveproductFeature(productFeatures.FeatureId)"
                                                    title="Quitar característica">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* bloque búsqueda y añadir características *@
                <div class="col-md-12 mb-3">
                    <div class="p-3 bg-light rounded border">
                        <label class="form-label fw-bold small text-uppercase text-muted mb-2">
                            <i class="bi bi-search me-1"></i> Añadir característica 
                        </label>
                        <input type="text" class="form-control form-control-sm mb-2" placeholder="Escribe para filtrar..." @bind="_filtroFeatures" @bind:event="oninput" />

                        <div class="d-flex gap-2">
                            <select class="form-select form-select-sm shadow-sm" size="5" @bind="selectedFeatureId">
                                @foreach (var feature in filteredFeatures)
                                {
                                    <option value="@feature.Id">@feature.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center" @onclick="AddSelectedFeature" title="Añadir a la lista">
                                <i class="bi bi-plus-lg fs-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>



        <div class="d-flex gap-2">
            @if (!IsReadOnly)
            {
                <button type="submit" class="btn btn-primary">Guardar</button>
            }
            <button type="button" class="btn btn-secondary" @onclick="Cancel">@(IsReadOnly ? "Volver" : "Cancelar")</button>
        </div>

    </EditForm>
}

<ConfirmModal Show="@(AiDescription != string.Empty)"
              IsError="false"
              Title="Descripción generada por IA"
              Message="@AiDescription"
              ConfirmText="Aceptar"
              CancelText="Cancelar"
              OnConfirm="ConfirmAiDescription"
              OnCancel="CancelProductDeletion" />


@code {

    private string activeTab = "general";

    // 2. El objeto que va a "viajar" al backend.
    private ProductDto productDto = new();


    //Listas de datos para seleccionar opciones del producto
    private List<ColorDto> availableColors = new();
    private List<CategoryDto> availableCategories = new();
    private List<SizeDto> availableSizes = new();
    private List<SizeGroupDto> availableSizeGroups = new();    
    private List<DataSourceDto> availableDataSources = new();    
    private List<MarketplaceDto> availableMarketplaces = new();
    private List<MarketplaceDto> filteredMarketplaces => availableMarketplaces.Where(mp => mp.Name.Contains(_filtroMarketplaces, StringComparison.OrdinalIgnoreCase)).ToList();
    private List<FeatureDto> availableFeatures = new();
    private List<FeatureDto> filteredFeatures => availableFeatures.Where(mp => mp.Name.Contains(_filtroFeatures, StringComparison.OrdinalIgnoreCase)).ToList();

    private string AiDescription = string.Empty;

    private string _filtroMarketplaces = "";
    private string _filtroFeatures = "";

    private Guid? selectedSizeGroups;
    private Guid? selectedSize;
    private Guid? selectedMarketplaceId;
    private Guid? selectedFeatureId;
    // Propiedad puente: el select lee/escribe el ÚNICO DataSource del DTO.
    private Guid? SelectedDataSourceId
    {
        get => productDto.ProductDataSources?.FirstOrDefault()?.DataSourceId;
        set
        {
            productDto.ProductDataSources ??= new List<ProductDataSourceDto>();
            productDto.ProductDataSources.Clear(); // Siempre 0 o 1: regla de origen único

            if (value is not null)
            {
                productDto.ProductDataSources.Add(new ProductDataSourceDto
                {
                    ProductId = productDto.Id,
                    DataSourceId = value.Value,
                    ExternalCode = string.Empty
                });
            }
        }
    }

    private ProductDataSourceDto? CurrentProductDataSource => productDto.ProductDataSources?.FirstOrDefault();

    // Propiedad puente: el select lee/escribe la ÚNICA Categoría del DTO.
    private Guid? SelectedCategoryId
    {
        get => productDto.CategoryIds?.FirstOrDefault();
        set
        {
            productDto.CategoryIds ??= new List<Guid>();
            productDto.CategoryIds.Clear(); // Siempre 0 o 1: regla de origen único

            if (value is not null)
            {
                Guid categoryId = value.Value;
                productDto.CategoryIds.Add(categoryId);
            }
        }
    }


    // 1. Se ejecuta al entrar en la página. Si es edición, carga los datos.
    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            var result = await ProductsClient.GetProductDetailByIdAsync(Id.Value);

            if (result.IsSuccess && result.Data != null)
            {
                // Rellenamos el formulario con los datos
                productDto = new ProductDto
                {
                    Id = result.Data.Id,
                    Sku = result.Data.Sku,
                    Name = result.Data.Name,
                    Description = result.Data.Description,
                    Price = result.Data.Price,
                    Stock = result.Data.Stock,
                    IsActive = result.Data.IsActive,

                    // Mapeamos los colores a la lista de IDs que usa el formulario
                    ColorIds = result.Data.Colors?.Select(c => c.Id).ToList() ?? new List<Guid>(),
                    CategoryIds = result.Data.Categories?.Select(c => c.Id).ToList() ?? new List<Guid>(),
                    ProductSizes = result.Data.ProductSizes,
                    ProductDataSources = result.Data.ProductDataSources ?? new List<ProductDataSourceDto>(),
                    ProductMarketplaces = result.Data.ProductMarketplaces ?? new List<ProductMarketplaceDto>(),
                    ProductFeatures = result.Data.ProductFeatures ?? new List<ProductFeatureDto >()

                };


                // Nos suscribimos al evento de finalización de la mejora de descripción
                NotificationService.OnTaskCompleted += OnAiTaskCompleted;
            }

            else
            {
                ErrorMessage = "No se pudo cargar el producto.";
            }
        }
        else
        {
            // Para creación, aseguramos que la lista de colores no sea nula
            productDto.ColorIds = new List<Guid>();
            productDto.CategoryIds = new List<Guid>();
        }


        //CARGAMOS todos los COLORES disponibles
        var colorsResult = await ColorClient.GetAllColorsAsync();
        if (colorsResult.IsSuccess)
        {
            availableColors = colorsResult.Data ?? new();
        }

        //CARGAMOS todas las CATEGORIAS disponibles
        var categoriesResult = await CategoryClient.GetAllCategoriesAsync();
        if (categoriesResult.IsSuccess)
        {
            availableCategories = categoriesResult.Data ?? new();
        }


        //CARGAMOS todas las tallas disponibles
        var sizesResult = await SizeClient.GetAllSizesAsync();
        if (sizesResult.IsSuccess)
        {
            availableSizes = sizesResult.Data ?? new();
        }


        //CARGAMOS todas grupos de datasources disponibles
        var datasourceResult = await DataSourceClient.GetAllDataSourceAsync();
        if (datasourceResult.IsSuccess)
        {
            availableDataSources = datasourceResult.Data ?? new();
        }


        //cargamos todos los marketplaces disponibles
        var marketplacesResult = await MarketplaceClient.GetAllMarketplaceAsync();
        if (marketplacesResult.IsSuccess)
        {
            availableMarketplaces = marketplacesResult.Data ?? new();
        }

        //CARGAMOS todas las features disponibles
        var featuresResult = await FeatureClient.GetAllFeaturesAsync();
        if (featuresResult.IsSuccess)
        {
            availableFeatures = featuresResult.Data ?? new();
        }

        IsLoading = false;

    }

    // 2. Se ejecuta al pulsar "Guardar"
    private async Task HandleSubmit()
    {

        if (IsReadOnly) return;//per si de cas

        if (FormValidation())
        {

            IsSaving = true;

            ApiResult<ProductDto> result;

            // Decidimos si crear o actualizar según si tenemos un Id
            if (IsEdit)
            {
                result = await ProductsClient.UpdateProductAsync(Id.Value, productDto);
            }
            else
            {
                result = await ProductsClient.CreateProductAsync(productDto);
            }

            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/products"); // Vuelve al grid (ajusta la ruta si es distinta)
            }
            else
            {
                ToastService.ShowError(ErrorHandler.HandleError(result));
            }

            IsSaving = false;
        }
    }

    private bool FormValidation()
    {
        string error = "";

        // Validación existente de colores
        if (productDto.ColorIds.Count() == 0)
        {
            error += "El producto debe tener al menos un color \n";
        }

        // Validación de categoría única
        if (!productDto.CategoryIds.Any())
        {
            error += "El producto debe tener asignada una categoría.\n";
        }

        // Validación de variantes (tallas)
        if (productDto.ProductSizes != null && productDto.ProductSizes.Any())
        {
            for (int i = 0; i < productDto.ProductSizes.Count; i++)
            {
                var productSize = productDto.ProductSizes[i];

                // Validar SKU requerido
                if (string.IsNullOrWhiteSpace(productSize.Sku))
                {
                    error += $"La talla {productSize.SizeName} (fila {i + 1}) requiere un SKU.\n";
                }
                // Validar formato de SKU
                else if (!System.Text.RegularExpressions.Regex.IsMatch(productSize.Sku, @"^[A-Z0-9\-]+$"))
                {
                    error += $"El SKU de la talla {productSize.SizeName} (fila {i + 1}) solo admite mayúsculas, números y guiones.\n";
                }

                if (productSize.Price < 0)
                {
                    error += $"El precio  de la talla {productSize.SizeName} (fila {i + 1}) debe ser superior a 0.\n";
                }
            }

        }

        if (!string.IsNullOrEmpty(error))
        {
            ToastService.ShowError(error);
            return false;
        }
        return true;
    }

