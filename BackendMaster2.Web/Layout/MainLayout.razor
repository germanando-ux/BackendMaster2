@using BackendMaster2.Web.Components
@using BackendMaster2.Web.Interfaces
@inherits LayoutComponentBase
@inject ISessionService SessionService
@inject NavigationManager NavigationManager
@inject INotificationClientService NotificationService

<div class="app-layout">
    <nav class="app-navbar">
        <button class="navbar-toggle" @onclick="AlternarSidebar" title="Menú"><i class="bi bi-list"></i></button>
        <div class="navbar-brand">BackendMaster2</div>
        <button class="navbar-logout" title="Cerrar sesión" @onclick="CerrarSesionAsync">
            Salir
        </button>
    </nav>

    <div class="app-body">         
        <aside class="app-sidebar @(_sidebarAlternado ? "alternado" : "")">
            <nav class="sidebar-menu">
         
                <NavLink href="/" class="sidebar-link" Match="NavLinkMatch.All"><i class="bi bi-house-door"></i><span class="link-texto">Inicio</span></NavLink>
                <NavLink href="/products" class="sidebar-link"><i class="bi bi-box-seam"></i><span class="link-texto">Productos</span></NavLink>
                <NavLink href="/users" class="sidebar-link"><i class="bi bi-people"></i><span class="link-texto">Usuarios</span></NavLink>
                <div class="w-100">
                    <button @onclick="AlternarCatalogo"
                            class="sidebar-link d-flex align-items-center gap-2 w-100"
                            style="background:transparent;border:none;cursor:pointer;font:inherit;text-align:left;">
                        <i class="bi bi-collection"></i>
                        <span class="link-texto">Catálogo</span>
                        <i class="bi bi-chevron-down ms-auto"
                           style="transition:transform .2s;transform:@(_catalogoAbierto ? "rotate(180deg)" : "rotate(0deg)");"></i>
                    </button>
                    @if (_catalogoAbierto)
                    {
                        <div style="background:rgba(0,0,0,.05);">
                            <NavLink href="/colors" class="sidebar-link" style="padding-left:2.6rem;"> <i class="bi bi-palette"></i><span class="link-texto">Colores</span></NavLink>
                        </div>
                    }
                </div>
            </nav>
        </aside>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>
<ToastContainer />

@code {

    private bool _catalogoAbierto;

    private void AlternarCatalogo()
    {
        _catalogoAbierto = !_catalogoAbierto;
    }

    protected override void OnInitialized()
    {
        _catalogoAbierto = NavigationManager.Uri.Contains("/colors");
    }

    protected override async Task OnInitializedAsync()
    {
        // Se inicia una sola vez para toda la vida de la aplicación
        await NotificationService.StartAsync();
    }

    /// <summary>
    /// Cada vez que termina de cargar la página en el layout, se comprueba si la sesión sigue activa. Si no los hay, se redirige a la página de login.
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tokens = await SessionService.GetAsync();
            if (tokens == null)
            {
                NavigationManager.NavigateTo("/login");
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }


    /// <summary>
    /// Cierra la sesión del usuario.
    /// </summary>
    /// <returns></returns>
    private async Task CerrarSesionAsync()
    {
        await SessionService.DeleteAsync();
        NavigationManager.NavigateTo("/login");
    }
    /// <summary>
    /// Alterna la visibilidad de la barra lateral.
    /// </summary>
    private bool _sidebarAlternado;

    private void AlternarSidebar()
    {
        _sidebarAlternado = !_sidebarAlternado;
    }
}