@page "/products"
@using System.Net
@using BackendMaster2.Web.Components
@using BackendMaster2.Web.Interfaces
@using BackendMaster2.Web.Models.Dtos
@using BackendMaster2.Web.Services
@inject ISessionService SessionService
@inject NavigationManager NavigationManager
@inject IProductsClient ProductsClient

@inherits FormBaseComponent

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="mb-1">Productos</h1>
        <p class="text-muted mb-4">Gestión de productos</p>
    </div>
    <a href="/products/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
    </a>
</div>

@if (IsLoading)
{
    <p class="text-muted">Cargando productos…</p>
}
else if (ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}
else
{
    @* Cuadro de búsqueda inteligente *@
    <div class="card  shadow-sm mb-4">
        <div class="card mb-3 p-3 bg-light">
            <div class="row g-3 aling-items-end">
                <div class="col-md-11">
                    <label class="form-label fw-bold">Busqueda inteligente de productos</label>
                    <input type="text" class="form-control" placeholder="Ej: zapatillas running rojas por menos de 100€..." @bind="_smartSearchQuery" />
                </div>
                <div class="col-md-1 d-flex flex-column gap-2">
                    <!-- Label fantasma: invisible pero ocupa el mismo espacio que los otros labels -->
                    <label class="form-label mb-0" style="visibility: hidden;">Acciones</label>

                    <!-- Botones sin width ni height fijos -->
                    <div class="d-flex gap-1">                 
                        <button class="btn btn-primary flex-fill" @onclick="SmartSearch">
                            <i class="bi bi-search me-1"></i> Búsqueda IA
                        </button>
                    
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow mb-4">
        <div class="card mb-3 p-3 bg-light">
            <div class="row g-3 aling-items-end"> 
                <!-- 3. Primera columna: Ocupa 3 de las 12 partes del ancho (25%) -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">Buscar por</label>
                    <!-- Desplegable estándar de Bootstrap -->
                    <select class="form-select" @bind="_pendingSearchBy">
                        <option value="Name">Nombre</option>
                        <option value="Sku">SKU</option>
                    </select>
                </div>
                <!-- 4. Segunda columna: Ocupa 4 de las 12 partes (33%, un poco más ancha para el texto) -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Término de búsqueda</label>
                    <!-- Input de texto estándar de Bootstrap -->
                    <input type="text" class="form-control" placeholder="Ej: rojo, 123..." @bind="_pendingSearchTerm" />
                </div>
                <!-- 5. Tercera columna: Ocupa 3 de las 12 partes -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">Estado</label>
                    <select class="form-select" @bind="_pendingStatus">
                        <option value="Todos">Todos</option>
                        <option value="Activos">Activos</option>
                        <option value="Inactivos">Inactivos</option>
                    </select>
                </div>
                <!-- 6. Cuarta columna: Ocupa las 2 partes restantes (2+3+4+3 = 12). 'd-flex' y 'gap-2' ponen los botones en fila con un pequeño espacio entre ellos -->
                <div class="col-md-2 d-flex flex-column gap-2">
                    <!-- Label fantasma: invisible pero ocupa el mismo espacio que los otros labels -->
                    <label class="form-label mb-0" style="visibility: hidden;">Acciones</label>

                    <!-- Botones sin width ni height fijos -->
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-danger flex-fill" @onclick="LimpiarFiltros">
                            <i class="bi bi-x-circle me-1"></i> Limpiar
                        </button>
                        <button class="btn btn-primary flex-fill" @onclick="AplicarFiltros">
                            <i class="bi bi-search me-1"></i> Aplicar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    
        
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-encabezado-marca">
                <tr>            
                    @if (_mostrarScore)
                    {
                        <th>Exactitud de búsqueda</th>
                    }
                    <th style="cursor: pointer;" @onclick="@(() => ToggleSortLocal("Sku"))">SKU
                        <i class="bi @GetSortIcon("Sku")"></i>
                     </th>
                    <th style="cursor: pointer;" @onclick="@(() => ToggleSortLocal("Name"))">Nombre
                        <i class="bi @GetSortIcon("Name")"></i>
                        </th>
                    <th style="cursor: pointer;" @onclick="@(() => ToggleSortLocal("Price"))">Precio
                        <i class="bi @GetSortIcon("Price")"></i>
                    </th>
                    <th style="cursor: pointer;" @onclick="@(() => ToggleSortLocal("Stock"))">Stock
                        <i class="bi @GetSortIcon("Stock")"></i></th>
                    <th>Estado</th>
                    <th>Acciones</th>


                </tr>
            </thead>
            <tbody>

                @foreach (var item in _productsSmartSearch)

                {

                    <tr>
                        @if (_mostrarScore)
                        {
                            <td style="width: 140px;">
                                <div class="d-flex align-items-center gap-2">
                                    <!-- La "píldora" de color: estilo 100% inline, cero dependencias -->
                                    <div style="width: 80px; height: 8px; border-radius: 4px; background-color: @GetScoreHex(item.SimilarityScore);">
                                    </div>
                                    <!-- El porcentaje numérico -->
                                    <span class="text-muted fw-bold" style="font-size: 0.75rem; min-width: 35px;">
                                        @((item.SimilarityScore * 100).ToString("F0"))%
                                    </span>
                                </div>
                            </td>
                        }
                        <td>@item.Product.Sku</td>
                        <td>@item.Product.Name</td>
                        <td>@item.Product.Price.ToString("N2")</td>
                        <td>@item.Product.Stock</td>
                        <td>
                            @if (item.Product.IsActive)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-center align-middle">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/products/detail/@item.Product.Id" class="btn btn-sm btn-outline-info" title="Consultar producto">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="/products/edit/@item.Product.Id" class="btn btn-sm btn-outline-primary" title="Editar producto">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar producto" @onclick="() => PrepareProductDeletion(item.Product.Id, item.Product.Name)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmModal Show="@(_pendingProductId.HasValue)"
              IsError="@_isErrorModal"
              Title="@(_isErrorModal ? "No se puede eliminar" : "Eliminar producto")"
              Message="@_pendingProductName"
              ConfirmText="Eliminar"
              CancelText="Cancelar"
              OnConfirm="ConfirmProductDeletionAsync"
              OnCancel="CancelProductDeletion" />

@code {
    private List<ProductDto> _products = new();
    private List<ProductSearchHybridDto> _productsSmartSearch = new();
    private Guid? _pendingProductId;
    private string? _pendingProductName;
    private bool _isErrorModal;
    private string? _pendingSearchBy;
    private string? _pendingSearchTerm;
    private string? _pendingStatus;
    private string? _smartSearchQuery;
    private bool _mostrarScore = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync(bool smartSearch = false)
    {

        bool? estadoFiltro = null;

        if (!smartSearch) //búsqueda normal
        {
            _mostrarScore = false;
            IsLoading = true;
            ErrorMessage = null; // Limpiamos errores anteriores

            if (_pendingStatus == "Activos")
            {
                estadoFiltro = true;
            }
            else if (_pendingStatus == "Inactivos")
            {
                estadoFiltro = false;
            }



            BaseQueryDto query = new BaseQueryDto
            {
                SortBy = CurrentSortBy,
                SortAscending = CurrentSortAscending,
                SearchBy = _pendingSearchBy,
                SearchTerm = _pendingSearchTerm,
                IsActive = estadoFiltro
            };

            var result = await ProductsClient.GetAllProductsAsync(query);

            if (!result.IsSuccess)
            {
                ErrorMessage = ErrorHandler.HandleError(result);
                IsLoading = false;
                return;
            }
            _products = result.Data ?? new List<ProductDto>();
            _productsSmartSearch = _products.Select(p => new ProductSearchHybridDto { Product = p, SimilarityScore = 0 }).ToList(); 
        }
        else //búsqueda inteligente
        {
            _mostrarScore = true;

            if (!string.IsNullOrEmpty(_smartSearchQuery.Trim()))
            {
                IsLoading = true;
                ErrorMessage = null; // Limpiamos errores anteriores

                var result = await ProductsClient.GetAllProductsHybridSearch(_smartSearchQuery);

                if (!result.IsSuccess)
                {
                    ErrorMessage = ErrorHandler.HandleError(result);
                    IsLoading = false;
                    return;
                }
                _productsSmartSearch = result.Data ?? new List<ProductSearchHybridDto>();
            }
        }

        IsLoading = false;

    }
    private void PrepareProductDeletion(Guid id, string name)
    {
        _pendingProductId = id;
        _pendingProductName = name;
        _isErrorModal = false;
    }

    private void CancelProductDeletion()
    {
        _pendingProductId = null;
        _pendingProductName = null;
        _isErrorModal = false;
    }

    private async Task ConfirmProductDeletionAsync()
    {
        if (!_pendingProductId.HasValue) return;

        var result = await ProductsClient.DeleteProductAsync(_pendingProductId.Value);

        if (result.IsSuccess)
        {
            await LoadProductsAsync();
            CancelProductDeletion();
        }
        else
        {
            _isErrorModal = true;
            _pendingProductName = ErrorHandler.HandleError(result);
        }
    }

    private async Task ToggleSortLocal(string columnName)
    {
        ToggleSort(columnName);
        await LoadProductsAsync();
    }



    private async Task LimpiarFiltros()
    {
        _pendingSearchBy = "Name";
        _pendingSearchTerm = "";
        _pendingStatus = "Todos";
        _mostrarScore = false;

        await LoadProductsAsync();
    }

    private async Task  AplicarFiltros()
    {
        await LoadProductsAsync();
    }

    private async Task SmartSearch()
    {
        await LoadProductsAsync(true);
    }

    private string GetScoreColor(double score)
    {
        if (score >= 0.8)
        {
            return "bg-success";      // Verde: Alta coincidencia
        }
        else if (score >= 0.6) 
        {
            return "bg-warning";      // Amarillo: Coincidencia media
        }
        else 
        {
        return "bg-danger";           // Rojo: Baja coincidencia (cerca del umbral)
        }
    }

    private string GetScoreHex(double score)
    {
        if (score >= 0.8)
        {
            return "#28a745";      // Verde: Alta coincidencia
        }
        else if (score >= 0.6) 
        {
            return "#ffc107";      // Amarillo: Coincidencia media
        }
        else 
        {
            return "#dc3545";           // Rojo: Baja coincidencia (cerca del umbral)
        }
    }
}