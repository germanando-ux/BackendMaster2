@page "/products/create"
@page "/products/{Mode}/{Id:guid}"

@using BackendMaster2.Web.Components
@using BackendMaster2.Web.Interfaces
@using BackendMaster2.Web.Models.Dtos
@using BackendMaster2.Web.Services

@inject IProductsClient ProductsClient
@inject NavigationManager Navigation
@inject IColorClient ColorClient
@inject ToastService ToastService
@inject INotificationClientService NotificationService

@inherits FormBaseComponent //hereda de FormBaseComponent para manejar errores y variables de estado


@if (IsLoading)
{
    <div class="alert alert-info"> Cargando datos...</div>
}
else
{
     <EditForm Model="dto" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        @if (IsReadOnly)
        {
            <div class="alert alert-info py-2 mb-3 small">
                <i class="bi bi-eye me-2"></i>Modo consulta: campos de solo lectura.
            </div>
        }
        <div class="col-md-8 mb-3">
            <label class="form-label">SKU</label>
            <input type="text" class="form-control border-primary " @bind="dto.Sku" disabled="@IsReadOnly" />
            <ValidationMessage For="@(() => dto.Sku)" class="text-danger small" />
        </div>

        <div class="col-md-8 mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control border-primary" @bind="dto.Name" disabled="@IsReadOnly" />
            <ValidationMessage For="@(() => dto.Name)" class="text-danger small" />
        </div>

        <div class=" col-md-8 mb-3 gap-3">
            <label class="form-label">Descripción</label>
            <div class="d-flex gap-3 align-items-center">
                @* <div class="flex-grow-1"> *@
                    <textarea class="form-control border-primary" rows="3" @bind="dto.Description" disabled="@IsReadOnly"></textarea>
                    <ValidationMessage For="@(() => dto.Description)" class="text-danger small" />
                @* </div> *@
                <button type="button" class="btn btn-primary" @onclick="RequestAiEnhancementAsync">Mejorar descripción (IA)</button>
            </div>
        </div>

        <div class="col-6 mb-3">
            <label class="form-label">Precio</label>
            <div class="gap-3">
                <NumberInput @bind-Value="dto.Price" CssClass="form-control" class="border-primary" required />
                <ValidationMessage For="@(() => dto.Price)" class="text-danger small" />
            </div>
        </div>

        <div class="col-6 mb-3">
            <label class="form-label">Stock</label>
            <input type="number" class="form-control border-primary" @bind="dto.Stock" required />
            <ValidationMessage For="@(() => dto.Stock)" class="text-danger small" />
        </div>

        <div class="mb-4 form-check">
            <input type="checkbox" class="form-check-input" @bind="dto.IsActive" disabled="@IsReadOnly" />
            <label class="form-check-label">Producto Activo</label>
        </div>

        <hr class="my-4" />

        <div class="mb-4">
            <label class="form-label fw-semibold fs-5">Colores</label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var color in availableColors)
                {
                    var seleccionado = dto.ColorIds.Contains(color.Id);

                    <div class="d-flex align-items-center gap-2 border rounded p-2" @onclick="() => ToggleColor(color.Id)"
                         style="cursor::@(IsReadOnly ? "default" : "pointer"); border-color:@(seleccionado ? "#0d6efd" : "#dee2e6") !important;background:@(seleccionado ? "#e7f1ff" : "white");">
                        <div style="width:28px; height:28px; background-color:@color.HexCode; border:1px solid #ccc; border-radius:4px;"></div>
                        <div>
                            <div class="small fw-semibold">@color.Name</div>
                            <div class="small text-muted font-monospace">@color.HexCode</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            @if (!IsReadOnly)
            {
                <button type="submit" class="btn btn-primary">Guardar</button>
            }
            <button type="button" class="btn btn-secondary" @onclick="Cancel">@(IsReadOnly ? "Volver" : "Cancelar")</button>
        </div>

    </EditForm>
}

<ConfirmModal Show="@(AiDescription != string.Empty)"
              IsError="false"
              Title="Descripción generada por IA"
              Message="@AiDescription"
              ConfirmText="Aceptar"
              CancelText="Cancelar"
              OnConfirm="ConfirmAiDescription"
              OnCancel="CancelProductDeletion" />


@code {


    // 2. El objeto que va a "viajar" al backend.
    private ProductDto dto = new();

    private List<ColorDto> availableColors = new();
    private string AiDescription = string.Empty;

    // 1. Se ejecuta al entrar en la página. Si es edición, carga los datos.
    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            var result = await ProductsClient.GetProductDetailByIdAsync(Id.Value);

            if (result.IsSuccess && result.Data != null)
            {
                dto = result.Data.Product; // Rellenamos el formulario con los datos

                // 1. Iniciamos la conexión de SignalR
                await NotificationService.StartAsync();

                // 2. Nos suscribimos al evento de finalización
                NotificationService.OnTaskCompleted += OnAiTaskCompleted;
            }
            else
            {
                ErrorMessage = "No se pudo cargar el producto.";
            }                    
        }

        //cargamos todos los colores disponibles
        var colorsResult = await ColorClient.GetAllColorsAsync();
        if (colorsResult.IsSuccess)
        {
            availableColors = colorsResult.Data ?? new();
        }
        IsLoading = false;
    }

    // 2. Se ejecuta al pulsar "Guardar"
    private async Task HandleSubmit()
    {

        if (IsReadOnly) return;//per si de cas

        if (FormValidation())
        {

            IsSaving = true;

            ApiResult<ProductDto> result;

            // Decidimos si crear o actualizar según si tenemos un Id
            if (IsEdit)
            {
                result = await ProductsClient.UpdateProductAsync(Id.Value, dto);
            }
            else
            {
                result = await ProductsClient.CreateProductAsync(dto);
            }

            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/products"); // Vuelve al grid (ajusta la ruta si es distinta)
            }
            else
            {
                ToastService.ShowError(ErrorHandler.HandleError(result));
            }

            IsSaving = false;
        }
    }

    private bool FormValidation()
    {
        string error = "";
        //validamos que el produto tenga al menos un color
        if  (dto.ColorIds.Count() == 0)
        {
            error += "El producto debe tener al menos un color \n";
        }
        if (!string.IsNullOrEmpty(error))
        {
            ToastService.ShowError(error);
            return false;
        }
        return true;
    }

    // 3. Acción para el botón Cancelar
    private void Cancel()
    {
        Navigation.NavigateTo("/products");
    }

    /// <summary>
    /// Añade o quita un color de la selección del producto (toggle).
    /// </summary>
    private void ToggleColor(Guid colorId)
    {
        if (IsReadOnly) return;

        if (dto.ColorIds.Contains(colorId))
        {
            dto.ColorIds.Remove(colorId);   // Ya estaba elegido → lo quitamos
        }
        else
        {
            dto.ColorIds.Add(colorId);      // No estaba → lo añadimos
        }
    }

    private async Task RequestAiEnhancementAsync()
    {
        var request = new EnrichDescriptionRequestDto
        {
            CurrentDescription = dto.Description,
            Colors = availableColors.Where(c => dto.ColorIds.Contains(c.Id)).Select(c => c.Name).ToList(),
            Price = dto.Price,
            SRConnectionId = Guid.NewGuid().ToString()
        };  

        var result = await ProductsClient.EnrichDescriptionAsync(request);

    }    

# region EventosDeSignalR

    private void OnAiTaskCompleted(string taskId, string enhancedDescription)
    {
        // Actualizamos la descripción en el DTO
        AiDescription = enhancedDescription;


        // CRÍTICO: Forzar la actualización de la interfaz de usuario
         _= InvokeAsync(StateHasChanged);
    }

    //se ejecuta al salir de la página para desuscribirse del evento y evitar memory leaks
    public void DisposeAsync()
    {
        NotificationService.OnTaskCompleted -= OnAiTaskCompleted;
    }

#endregion

    private void ConfirmAiDescription()
    {
        dto.Description = AiDescription;
        AiDescription = string.Empty;
    }
    private void CancelProductDeletion()
    {
        AiDescription = string.Empty;
    }
}
